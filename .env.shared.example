# ==============================================================================
# CloudBox — Shared Server Environment Configuration Template (.env.shared)
# Use this on the machine hosting PostgreSQL, MinIO, and Redis.
# ==============================================================================

APP_ENV=production

# Security & Token Keys (MUST match on all laptop nodes)
SECRET_KEY=32d2ae0a0c382c54f38d614ee2ea0a84ab12f4c649563a48a59765ff46405c3a
JWT_SECRET_KEY=336f4a1c52c4471aae0a539f9d503e6b844a648ad6c3ad1c57394257c8f1286c
JWT_ACCESS_TOKEN_EXPIRES=86400

# PostgreSQL Database Configuration
POSTGRES_PORT=5432
POSTGRES_DB=cloudbox_db
POSTGRES_USER=cloudbox_user
POSTGRES_PASSWORD=password123

# MinIO Object Storage Configuration
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=cloudbox_admin
MINIO_ROOT_PASSWORD=password123
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=cloudbox-uploads

# Redis Message Broker & Cache Configuration
REDIS_PORT=6379
REDIS_PASSWORD=password123
