# ==============================================================================
# CloudBox Environment Configuration Template
# Copy this file to .env and adjust variables as required.
#
# For Shared Multi-Laptop Mode:
#   Set POSTGRES_HOST, MINIO_HOST, and REDIS_HOST to the Shared Server's IP
#   (e.g., POSTGRES_HOST=192.168.1.100, MINIO_HOST=192.168.1.100, REDIS_HOST=192.168.1.100)
#   Ensure SECRET_KEY and JWT_SECRET_KEY are identical on all nodes.
# ==============================================================================

# Application Environment
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=32d2ae0a0c382c54f38d614ee2ea0a84ab12f4c649563a48a59765ff46405c3a
JWT_SECRET_KEY=336f4a1c52c4471aae0a539f9d503e6b844a648ad6c3ad1c57394257c8f1286c
JWT_ACCESS_TOKEN_EXPIRES=86400
MAX_CONTENT_LENGTH=52428800

# Host Exposed Ports
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=5173
BACKEND_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093

# Domain & HTTPS Configuration
DOMAIN_NAME=cloudbox.example.com
ACME_EMAIL=admin@example.com
ENABLE_HTTPS=false
CERTBOT_STAGING=0

# PostgreSQL Configuration (Use 'db' for local Docker, or Shared Server IP for multi-device)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cloudbox_db
POSTGRES_USER=cloudbox_user
POSTGRES_PASSWORD=password123

# MinIO Object Storage Configuration (Use 'minio' for local Docker, or Shared Server IP for multi-device)
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_ROOT_USER=cloudbox_admin
MINIO_ROOT_PASSWORD=password123
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=cloudbox-uploads

# Redis Configuration (Use 'redis' for local Docker, or Shared Server IP for multi-device)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password123

# Remote Off-Site Backup Replication (AWS S3 / Cloudflare R2 / MinIO)
REMOTE_BACKUP_ENABLED=false
REMOTE_BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
REMOTE_BACKUP_BUCKET=cloudbox-offsite-backups
REMOTE_BACKUP_ACCESS_KEY=your-remote-s3-access-key
REMOTE_BACKUP_SECRET_KEY=your-remote-s3-secret-key
REMOTE_BACKUP_REGION=us-east-1
BACKUP_RETENTION_COUNT=10

# Monitoring & Alerting Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password123
PROMETHEUS_RETENTION_TIME=15d
ALERT_WEBHOOK_URL=http://localhost:5000/api/alerts/webhook
ALERT_EMAIL_TO=alerts@example.com

# Frontend Configuration
VITE_API_URL=http://localhost:5000
